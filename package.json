{
  "name": "rota-plus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "start": "node server/index.js",
    "db:reset": "node server/reset.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "nodemailer": "^10.1.7",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  },
  "description": "Rota+ — rastreabilidade de entregas e ativos (React + Express + SQLite)",
  "engines": {
    "node": ">=22.13"
  }
}
